# Copy to .env (or export in your shell / CI). Values match docker-compose.yml defaults.

SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/hiresense
SPRING_DATASOURCE_USERNAME=hiresense
SPRING_DATASOURCE_PASSWORD=hiresense

# AI matching/question generation. "template" = deterministic fallback (no account needed).
# Reserved for upcoming phases; safe to leave untouched.
AI_PROVIDER=template
GEMINI_API_KEY=

# SMTP via MailPit container in development. Reserved for upcoming phases.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
